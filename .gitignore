profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of microservices or stand-alone apps, it might be better to lock the deps.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is declared in the project's interest to lock the deps.
# poetry.lock

# pdm
.pdm.toml
.pdm-plugins/

# uv  (uv.lock IS committed — it pins the dependency graph; see guidelines §8.4)
.venv/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Project specific — secrets (never commit real credentials)
.env
*.key
*.pem
credentials.json

# Match logs (generated at runtime; keep the results/ folder itself)
results/*.log
results/*.jsonl
